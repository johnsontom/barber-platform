{
  "name": "barber-platform",
  "version": "1.0.0",
  "private": true,
  "description": "A location-based barbershop discovery and appointment booking platform.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-booking.js",
    "email:check": "node scripts/check-email.js",
    "db:inspect": "node scripts/inspect-booking-schema.js",
    "home:configure": "node scripts/configure-home-services.js",
    "home:check": "node scripts/check-home-service-salons.js",
    "google:check": "node scripts/check-google-routing.js",
    "db:migrate": "node scripts/migrate-booking.js",
    "test:mysql": "node --test test/mysql.integration.js",
    "test:barbers:mysql": "node --test test/barber-services.integration.js",
    "test:categories:mysql": "node --test test/service-categories.integration.js",
    "test:notifications:mysql": "node --test test/live-notifications.integration.js",
    "test:platform:mysql": "node --test test/platform.integration.js",
    "test:admin:mysql": "node --test test/admin-salon.integration.js",
    "test:forum:mysql": "node --test test/forum.integration.js",
    "test:password:mysql": "node --test test/password-reset.integration.js",
    "test:verification:mysql": "node --test test/email-verification.integration.js",
    "preview:booking": "node scripts/preview-booking.js",
    "preview:availability": "node scripts/preview-availability.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.3.1",
    "pug": "^3.0.3",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
