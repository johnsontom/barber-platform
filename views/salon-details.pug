
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="theme-color" content="#11110f")
    title= title
    link(rel="stylesheet" href="/css/styles.css")
    style.
      .salon-profile {
        --sp-bg: #11110f;
        --sp-card: #1b1d17;
        --sp-border: #34392b;
        --sp-text: #f4f5ed;
        --sp-muted: #b6bcaa;
        --sp-accent: #c7ff55;
        color: var(--sp-text);
      }

      .salon-profile .salon-hero {
        position: relative;
        min-height: 280px;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        padding: 30px;
        margin: 25px 0 35px;
        border: 1px solid var(--sp-border);
        border-radius: 20px;
        background: linear-gradient(135deg, #272d1d, #151710);
        box-sizing: border-box;
      }

      .salon-profile .salon-hero-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .salon-profile .salon-hero::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg, rgba(10,12,8,.96), rgba(10,12,8,.15));
      }

      .salon-profile .salon-hero-content {
        position: relative;
        z-index: 1;
        width: 100%;
      }

      .salon-profile .salon-hero h1 {
        margin: 8px 0;
        color: #fff;
        font-size: clamp(30px, 5vw, 48px);
        line-height: 1.1;
      }

      .salon-profile .salon-hero p {
        margin: 0;
        color: #e0e4d7;
      }

      .salon-profile .salon-eyebrow {
        color: var(--sp-accent);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      .salon-profile .salon-back {
        display: inline-block;
        margin-top: 10px;
        color: var(--sp-muted);
        text-decoration: none;
      }

      .salon-profile .salon-back:hover {
        color: var(--sp-accent);
      }

      .salon-profile .salon-description {
        color: var(--sp-muted);
        line-height: 1.8;
      }

      .salon-profile .services-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 16px;
        flex-wrap: wrap;
        margin: 35px 0 20px;
      }

      .salon-profile .services-heading h2 {
        margin: 5px 0;
        color: var(--sp-text);
      }

      .salon-profile .services-heading p {
        margin: 0;
        color: var(--sp-muted);
      }

      .salon-profile .salon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
        gap: 20px;
      }

      .salon-profile .salon-card {
        min-width: 0;
        overflow: hidden;
        background: var(--sp-card);
        border: 1px solid var(--sp-border);
        border-radius: 16px;
        transition: transform .2s, border-color .2s;
      }

      .salon-profile .salon-card:hover {
        transform: translateY(-3px);
        border-color: #718344;
      }

      .salon-profile .service-image-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: linear-gradient(135deg, #303725, #181b14);
      }

      .salon-profile .service-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s;
      }

      .salon-profile .salon-card:hover .service-image {
        transform: scale(1.04);
      }

      .salon-profile .service-image-placeholder {
        display: flex;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
        color: var(--sp-accent);
        background: radial-gradient(circle at center, #343d25, #181b14 75%);
      }

      .salon-profile .service-image-placeholder span:first-child {
        font-size: 42px;
      }

      .salon-profile .service-image-placeholder span:last-child {
        color: var(--sp-muted);
        font-size: 11px;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .salon-profile .salon-card-body {
        padding: 20px;
      }

      .salon-profile .service-category {
        color: var(--sp-accent);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .salon-profile .salon-card h3 {
        margin: 8px 0;
        color: var(--sp-text);
        font-size: 20px;
      }

      .salon-profile .service-description {
        min-height: 42px;
        margin: 0 0 17px;
        color: var(--sp-muted);
        font-size: 13px;
        line-height: 1.7;
      }

      .salon-profile .salon-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 15px 0;
        margin-top: auto;
        border-top: 1px solid var(--sp-border);
      }

      .salon-profile .salon-meta span {
        color: var(--sp-muted);
        font-size: 12px;
      }

      .salon-profile .salon-meta strong {
        color: var(--sp-accent);
        font-size: 20px;
      }

      .salon-profile .service-book-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 9px;
        background: var(--sp-accent);
        color: #15180e;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: background .2s;
      }

      .salon-profile .service-book-link:hover {
        background: #ddff9b;
      }

      .salon-profile .salon-empty {
        padding: 35px 22px;
        border: 1px dashed var(--sp-border);
        border-radius: 14px;
        color: var(--sp-muted);
        text-align: center;
      }

      .salon-profile .salon-empty strong {
        display: block;
        margin-bottom: 8px;
        color: var(--sp-text);
      }

      @media (max-width: 560px) {
        .salon-profile .salon-hero {
          min-height: 240px;
          padding: 20px;
        }

        .salon-profile .salon-card-body {
          padding: 16px;
        }
      }

  body
    .site-shell.salon-profile
      header.navbar
        a.brand(href="/" aria-label="Barber Platform home")
          span.brand-mark B.
          span.brand-name BARBER #[span.brand-light PLATFORM]

        nav.nav-links
          a(href="/#discover") Discover
          a(href="/#how-it-works") How it works

        .nav-actions
          a.nav-login(href="/login") Log in
          a.button.button-small(href="/#discover") Find a barber

      main
        section.discover-section
          a.salon-back(href="/") ← Back to all salons

          .salon-hero
            if salon.cover_image
              img.salon-hero-image(
                src=salon.cover_image
                alt=salon.name + " salon"
                loading="eager"
              )
            .salon-hero-content
              span.salon-eyebrow SALON PROFILE
              h1= salon.name
              p= salon.address + ", " + salon.city

          if salon.description
            p.salon-description= salon.description
          else
            p.salon-description Discover the services available at this salon and choose the one that's right for you.

          .services-heading
            div
              p.salon-eyebrow THE SERVICE MENU
              h2 Services and pricing
              p Browse the services and book your preferred appointment.

          if services.length
            .salon-grid
              each service in services
                article.salon-card
                  .service-image-wrap
                    if service.image_url
                      img.service-image(
                        src=service.image_url
                        alt=service.name + " at " + salon.name
                        loading="lazy"
                      )
                    else
                      .service-image-placeholder
                        span(aria-hidden="true") ✂
                        span Service photo coming soon

                  .salon-card-body
                    span.service-category BARBER SERVICE
                    h3= service.name

                    if service.description
                      p.service-description= service.description
                    else
                      p.service-description A professional grooming service tailored to your style.

                    .salon-meta
                      span
                        icon-placeholder
                        | #{service.duration_minutes} minutes
                      strong= "£" + Number(service.price).toFixed(2)

                    a.service-book-link(href="/booking?service_id=" + service.id)
                      span Book this service
                      span(aria-hidden="true") →

          else
            .salon-empty
              strong No services available yet
              | This salon hasn't added any services. Please check back later.

      footer.footer
        a.brand(href="/")
          span.brand-mark B.
          span.brand-name BARBER #[span.brand-light PLATFORM]
        p Built around the people behind the chair.
        span.footer-note © 2026 Barber Platform · Student project prototype
