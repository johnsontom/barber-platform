
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="theme-color" content="#0b0c0a")
    title= title
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/styles.css")
    style.
      :root {
        --booking-bg: #0b0c0a;
        --booking-panel: #141510;
        --booking-border: #303229;
        --booking-gold: #c5a66b;
        --booking-text: #f5f3ed;
        --booking-muted: #a5a69e;
      }

      body.booking-body {
        margin: 0;
        background: var(--booking-bg);
        color: var(--booking-text);
        font-family: 'DM Sans', sans-serif;
      }

      .booking-nav {
        min-height: 72px;
        padding: 0 clamp(20px, 6vw, 90px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--booking-border);
        background: rgba(11, 12, 10, .96);
      }

      .booking-brand {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--booking-text);
        text-decoration: none;
        font-family: 'Manrope', sans-serif;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 2px;
      }

      .booking-brand-mark {
        color: var(--booking-gold);
        font-size: 34px;
        letter-spacing: -3px;
      }

      .booking-brand span:last-child span {
        color: var(--booking-muted);
        font-weight: 400;
      }

      .booking-nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .booking-nav-links a {
        color: #e2e0d9;
        text-decoration: none;
        font-size: 14px;
      }

      .booking-nav-links a:hover,
      .booking-back:hover {
        color: var(--booking-gold);
      }

      .booking-hero {
        position: relative;
        overflow: hidden;
        padding: 48px clamp(20px, 7vw, 105px) 32px;
        background:
          radial-gradient(ellipse at 82% 10%, rgba(197,166,107,.12), transparent 35%),
          linear-gradient(180deg, #11120f, var(--booking-bg));
      }

      .booking-hero::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 40%;
        height: 100%;
        pointer-events: none;
        background: linear-gradient(90deg, transparent, rgba(197,166,107,.025));
      }

      .booking-back {
        display: inline-block;
        margin-bottom: 34px;
        color: var(--booking-gold);
        text-decoration: none;
        font-weight: 600;
      }

      .booking-eyebrow {
        margin: 0 0 12px;
        color: var(--booking-gold);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
      }

      .booking-hero h1 {
        margin: 0;
        font-family: 'Manrope', sans-serif;
        font-size: clamp(34px, 5vw, 54px);
        line-height: 1.12;
        letter-spacing: -1.8px;
      }

      .booking-subtitle {
        margin: 14px 0 0;
        color: var(--booking-muted);
        font-size: 16px;
        line-height: 1.7;
      }

      .booking-page {
        width: min(100% - 40px, 1280px);
        margin: 0 auto;
        padding: 12px 0 64px;
      }

      .booking-error {
        margin: 0 0 22px;
        padding: 15px 18px;
        border: 1px solid #8d4740;
        border-radius: 10px;
        background: rgba(141,71,64,.12);
        color: #ffbdb5;
      }

      .booking-layout {
        display: grid;
        grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
        gap: 22px;
        align-items: stretch;
      }

      .booking-summary,
      .booking-form-panel {
        min-width: 0;
        padding: clamp(22px, 3vw, 34px);
        border: 1px solid var(--booking-border);
        border-radius: 18px;
        background: linear-gradient(145deg, #171813, #10110e);
        box-sizing: border-box;
      }

      .booking-section-label {
        margin: 0 0 18px;
        color: var(--booking-gold);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .booking-summary h2 {
        margin: 0 0 10px;
        font-family: 'Manrope', sans-serif;
        font-size: 28px;
        letter-spacing: -.7px;
      }

      .booking-address {
        margin: 0;
        color: var(--booking-muted);
        font-size: 14px;
        line-height: 1.7;
      }

      .booking-divider {
        height: 1px;
        margin: 25px 0;
        background: var(--booking-border);
      }

      .booking-service-label {
        margin: 0 0 14px;
        color: var(--booking-gold);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .booking-service-title {
        margin: 0 0 9px;
        font-family: 'Manrope', sans-serif;
        font-size: 22px;
      }

      .booking-service-description {
        margin: 0;
        color: var(--booking-muted);
        font-size: 14px;
        line-height: 1.8;
        overflow-wrap: anywhere;
      }

      .booking-service-placeholder {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        margin-bottom: 18px;
        border: 1px solid #514630;
        border-radius: 13px;
        background: #211e16;
        color: var(--booking-gold);
        font-size: 24px;
      }

      .booking-price-list {
        display: grid;
        gap: 0;
        margin-top: 25px;
      }

      .booking-price-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 15px 0;
        border-top: 1px solid var(--booking-border);
      }

      .booking-price-row span {
        color: var(--booking-muted);
      }

      .booking-price-row strong {
        color: var(--booking-text);
        text-align: right;
      }

      .booking-form-panel form {
        display: grid;
        gap: 11px;
      }

      .booking-form-panel label {
        margin-top: 8px;
        color: #e8e5dd;
        font-size: 14px;
        font-weight: 600;
      }

      .booking-form-panel input,
      .booking-form-panel textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 15px 16px;
        border: 1px solid #3a3b34;
        border-radius: 10px;
        background: #20211e;
        color: var(--booking-text);
        font: inherit;
        transition: border-color .2s, box-shadow .2s;
      }

      .booking-form-panel input:focus,
      .booking-form-panel textarea:focus {
        outline: none;
        border-color: var(--booking-gold);
        box-shadow: 0 0 0 3px rgba(197,166,107,.12);
      }

      .booking-form-panel input {
        min-height: 54px;
        color-scheme: dark;
      }

      .booking-form-panel textarea {
        min-height: 112px;
        resize: vertical;
        line-height: 1.6;
      }

      .booking-notes-counter {
        margin-top: -5px;
        color: var(--booking-muted);
        text-align: right;
        font-size: 12px;
      }

      .booking-submit {
        width: 100%;
        min-height: 56px;
        margin-top: 10px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(110deg, #b99454, #ddc38c);
        color: #17140d;
        font: inherit;
        font-weight: 800;
        cursor: pointer;
        transition: transform .2s, filter .2s;
      }

      .booking-submit:hover {
        transform: translateY(-1px);
        filter: brightness(1.08);
      }

      .booking-submit:disabled {
        cursor: wait;
        opacity: .7;
        transform: none;
      }

      .booking-help {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        margin: 13px 0 0;
        color: var(--booking-muted);
        font-size: 12px;
        line-height: 1.7;
        text-align: center;
      }

      .booking-help span {
        color: var(--booking-gold);
      }

      .booking-footer {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 24px clamp(20px, 6vw, 90px);
        border-top: 1px solid var(--booking-border);
        color: var(--booking-muted);
        font-size: 12px;
      }

      .booking-footer strong {
        color: var(--booking-gold);
        letter-spacing: 1px;
      }

      @media (max-width: 760px) {
        .booking-nav {
          padding: 16px 20px;
        }

        .booking-nav-links {
          gap: 14px;
        }

        .booking-nav-links a:first-child,
        .booking-nav-links a:nth-child(2) {
          display: none;
        }

        .booking-hero {
          padding-top: 32px;
        }

        .booking-page {
          width: min(100% - 28px, 620px);
          padding-bottom: 38px;
        }

        .booking-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 420px) {
        .booking-brand {
          gap: 8px;
          font-size: 12px;
          letter-spacing: 1px;
        }

        .booking-brand-mark {
          font-size: 28px;
        }

        .booking-hero h1 {
          letter-spacing: -1px;
        }

        .booking-summary,
        .booking-form-panel {
          padding: 21px;
        }
      }
  body.booking-body
    nav.booking-nav
      a.booking-brand(href="/")
        span.booking-brand-mark B.
        span
          | BARBER 
          span PLATFORM
      .booking-nav-links
        a(href="/") Home
        a(href="/#salons") Discover
        a(href="/dashboard") Dashboard

    header.booking-hero
      a.booking-back(href="/salons/" + service.salon_id) ← Back to salon
      p.booking-eyebrow Appointment
      h1 Book your appointment
      p.booking-subtitle Confirm your service and choose a date and time.

    main.booking-page
      if error
        .booking-error(role="alert")= error

      .booking-layout
        section.booking-summary
          p.booking-section-label Salon details
          h2= service.salon_name
          p.booking-address= service.address + ", " + service.city

          .booking-divider

          p.booking-service-label Your service
          .booking-service-placeholder(aria-hidden="true") ✂
          h3.booking-service-title= service.service_name
          if service.service_description
            p.booking-service-description= service.service_description
          else
            p.booking-service-description A professional grooming service tailored to your style.

          .booking-price-list
            .booking-price-row
              span Price
              strong £#{Number(service.price).toFixed(2)}
            .booking-price-row
              span Duration
              strong #{service.duration_minutes} minutes

        section.booking-form-panel
          p.booking-section-label Your appointment
          form#booking-form(method="POST" action="/booking")
            input(type="hidden" name="service_id" value=service.service_id)
            input(type="hidden" name="booking_token" value=bookingToken)

            label(for="appointment_at") Date and time
            input#appointment_at(
              type="datetime-local"
              name="appointment_at"
              value=form.appointment_at
              required
            )

            label(for="notes") Notes (optional)
            textarea#notes(
              name="notes"
              rows="4"
              maxlength="1000"
              placeholder="Anything the barber should know?"
            )= form.notes

            .booking-notes-counter
              span#notes-count 0
              |  / 1000

            button.booking-submit#booking-submit(type="submit") Request booking

            p.booking-help
              span(aria-hidden="true") 🔒
              | Your appointment will be pending until the salon confirms it.

    footer.booking-footer
      span
        strong B.
        |  &nbsp; BARBER PLATFORM
      span © 2026 Barber Platform · Student project prototype

    script.
      (() => {
        const form = document.getElementById('booking-form');
        const dateInput = document.getElementById('appointment_at');
        const notes = document.getElementById('notes');
        const count = document.getElementById('notes-count');
        const submit = document.getElementById('booking-submit');

        if (dateInput) {
          const now = new Date();
          now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
          dateInput.min = now.toISOString().slice(0, 16);
        }

        if (notes && count) {
          const updateCount = () => {
            count.textContent = notes.value.length;
          };
          notes.addEventListener('input', updateCount);
          updateCount();
        }

        if (form && submit) {
          form.addEventListener('submit', () => {
            submit.disabled = true;
            submit.textContent = 'Sending request...';
          });
        }
      })();
