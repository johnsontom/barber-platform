doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="robots" content="noindex, nofollow")
    title= title
    link(rel="stylesheet" href="/css/styles.css")
    link(rel="stylesheet" href="/css/password-reset.css")
    include partials/theme-head

  body.auth-body
    main.auth-layout
      section.auth-visual
        a.auth-brand(href="/")
          span.brand-mark B.
          span Barber Finder
        .auth-visual-content
          p.eyebrow YOUR ACCOUNT
          h1 Your next chapter.
            br
            span Starts here.
          p Choose a new password to return to your bookings and salon workspace.
        .auth-visual-footer
          span BARBER FINDER
          span ACCOUNT RECOVERY

      section.auth-form-side
        .auth-form-wrap
          a.auth-mobile-brand(href="/") Barber Finder
          p.eyebrow ACCOUNT RECOVERY
          h2 Choose a new password
          include partials/theme-toggle
          if error
            .auth-error(role="alert")= error
          if invalid
            unless error
              .auth-error(role="alert") This reset link is invalid, expired or already used. Request a new link to continue.
            a.auth-submit(href="/forgot-password") Request a new reset link
          else
            p.auth-subtitle Use at least 8 characters. You’ll sign in with this password after saving it.
            form.auth-form(action="/reset-password" method="POST")
              input(type="hidden" name="csrf_token" value=csrfToken)
              .form-field
                label(for="password") New password
                input#password(type="password" name="password" minlength="8" maxlength="72" required autocomplete="new-password" autofocus)
              .form-field
                label(for="password-confirmation") Confirm new password
                input#password-confirmation(type="password" name="password_confirmation" minlength="8" maxlength="72" required autocomplete="new-password")
              button.auth-submit(type="submit") Save new password
            p.field-hint For your security, you’ll be signed out on other devices after changing your password.
          a.auth-reset-link(href="/login") Back to login
