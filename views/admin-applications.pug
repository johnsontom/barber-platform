
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Owner Applications | Barber Platform
    link(rel="stylesheet" href="/css/styles.css")

  body.admin-body
    aside.admin-sidebar
      a.admin-brand(href="/dashboard")
        span.brand-mark B.
        span BARBER PLATFORM

      p.admin-nav-label WORKSPACE
      a.admin-nav-link(href="/dashboard") Overview
      a.admin-nav-link(href="/admin/salons") Salon Management
      a.admin-nav-link.active(href="/admin/applications") Owner Applications
      a.admin-nav-link(href="/") View Public Website

      div.admin-sidebar-bottom
        span.admin-status-dot ●
        span Administrator access
        form(action="/logout" method="POST")
          button.admin-logout(type="submit") Log out

    main.admin-main
      header.admin-topbar
        div
          p.eyebrow ADMINISTRATION
          h1 Owner Applications
          p.admin-muted Review salon-owner registrations and manage access to the platform.
        a.admin-back-link(href="/dashboard") ← Dashboard

      section.admin-welcome
        div
          span.admin-welcome-tag ACCESS CONTROL
          h2 The people behind the chairs.
          p Review applications before granting access to salon management.
        div.admin-welcome-symbol ✓

      section.admin-stats
        article.admin-stat-card
          span.admin-stat-label PENDING REVIEW
          strong.admin-stat-number= applications.length
          span.admin-stat-caption Awaiting a decision

        article.admin-stat-card
          span.admin-stat-label APPROVAL PROCESS
          strong.admin-stat-number MANUAL
          span.admin-stat-caption Decisions made by an administrator

        article.admin-stat-card
          span.admin-stat-label OWNER ACCESS
          strong.admin-stat-number RESTRICTED
          span.admin-stat-caption Approval required before management

      section.admin-panel.admin-applications-panel
        div.admin-panel-heading
          div
            p.eyebrow REVIEW QUEUE
            h2 Applications awaiting review
          span.admin-count= applications.length

        p.admin-muted Review each account and choose whether to approve or reject access.

        if applications.length
          div.application-list
            each application in applications
              article.application-card
                div.application-avatar= application.full_name.substring(0, 1).toUpperCase()

                div.application-details
                  div.application-title-row
                    h3= application.full_name
                    span.application-pending Pending review

                  p.application-email= application.email
                  p.application-note
                    | Registered as a salon owner. Approval is required before this account can manage a salon.

                div.application-actions
                  form(action="/admin/applications/" + application.id + "/approve" method="POST")
                    button.application-approve(type="submit") Approve

                  form(action="/admin/applications/" + application.id + "/reject" method="POST")
                    button.application-reject(type="submit") Reject

        else
          div.admin-empty-state.application-empty
            div.admin-empty-icon ✓
            h3 You're all caught up
            p There are no pending owner applications to review right now.
            a.button-link(href="/admin/salons") Manage salons →
