
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Salon Management | Barber Platform
    link(rel="stylesheet" href="/css/styles.css")

  body.admin-body
    aside.admin-sidebar
      a.admin-brand(href="/dashboard")
        span.brand-mark B.
        span BARBER PLATFORM

      p.admin-nav-label WORKSPACE
      a.admin-nav-link(href="/dashboard") Overview
      a.admin-nav-link.active(href="/admin/salons") Salon Management
      a.admin-nav-link(href="/admin/applications") Owner Applications
      a.admin-nav-link(href="/") View Public Website

      div.admin-sidebar-bottom
        span.admin-status-dot
        span Administrator access
        form(action="/logout" method="POST")
          button.admin-logout(type="submit") Log out

    main.admin-main
      header.admin-topbar
        div
          p.eyebrow ADMINISTRATION
          h1 Salon Management
          p.admin-muted Manage salon listings and assign approved owners.
        a.admin-back-link(href="/dashboard") ← Dashboard

      section.admin-welcome
        div
          span.admin-welcome-tag PLATFORM MANAGEMENT
          h2 Every salon, in one place.
          p Create salon listings and connect them to approved owner accounts.
        div.admin-welcome-symbol B.

      section.admin-stats
        article.admin-stat-card
          span.admin-stat-label TOTAL SALONS
          strong.admin-stat-number= salons.length
          span.admin-stat-caption Listings on the platform

        article.admin-stat-card
          span.admin-stat-label APPROVED OWNERS
          strong.admin-stat-number= barbers.length
          span.admin-stat-caption Available for assignment

        article.admin-stat-card
          span.admin-stat-label WORKSPACE
          strong.admin-stat-number LIVE
          span.admin-stat-caption Platform administration

      section.admin-content-grid
        section.admin-panel.admin-create-panel
          div.admin-panel-heading
            div
              p.eyebrow NEW LISTING
              h2 Create a salon
            span.admin-step 01

          p.admin-muted Add a business to the public salon directory.

          form.admin-form(action="/admin/salons" method="POST")
            div.admin-field
              label(for="name") Salon name
              input#name(type="text" name="name" maxlength="150" placeholder="e.g. Morrow & Blade" required)

            div.admin-field
              label(for="address") Street address
              input#address(type="text" name="address" maxlength="255" placeholder="Enter street address" required)

            div.admin-field
              label(for="city") City
              input#city(type="text" name="city" maxlength="100" placeholder="e.g. London" required)

            div.admin-field
              label(for="owner_id") Assign approved owner
              select#owner_id(name="owner_id")
                option(value="") No owner assigned yet
                each barber in barbers
                  option(value=barber.id)= barber.full_name

            div.admin-field
              label(for="description") About the salon
              textarea#description(name="description" rows="4" placeholder="Describe the salon and its services...")

            button.admin-primary-button(type="submit")
              span Create salon listing
              span →

        section.admin-panel.admin-directory-panel
          div.admin-panel-heading
            div
              p.eyebrow PLATFORM DIRECTORY
              h2 Salon listings
            span.admin-count= salons.length

          p.admin-muted Review listings and update their details.

          if salons.length
            div.admin-salon-list
              each salon in salons
                article.admin-salon-item
                  div.admin-salon-avatar= salon.name.substring(0, 1).toUpperCase()
                  div.admin-salon-info
                    h3= salon.name
                    p.admin-salon-location
                      span.admin-location-dot ●
                      |  #{salon.city}
                    p.admin-owner-line
                      | Owner: #{salon.owner_name || "Not assigned"}
                  div.admin-salon-actions
                    span.admin-listing-status Listed
                    a.admin-edit-link(href="/admin/salons/" + salon.id + "/edit") Edit →
          else
            div.admin-empty-state
              div.admin-empty-icon +
              h3 No salons yet
              p Create your first salon listing using the form.
