               a(href="/about") About Us
               a(href="/forum") Forum
            .nav-actions
            if currentUser
               a.nav-account(
                  href="/dashboard"
                  aria-label=(currentUser.role === "admin" ? "Administrator dashboard" : currentUser.role === "barber" ? "Salon manager dashboard" : "Customer account")
                  title=(currentUser.role === "admin" ? "Administrator" : currentUser.role === "barber" ? "Salon manager" : "My account")
               )
                     if currentUser.role === "admin"
                        span.nav-account-icon(aria-hidden="true") ♙
                        span.nav-account-label Admin
                     else if currentUser.role === "barber"
                        span.nav-account-icon(aria-hidden="true") ✂
                        span.nav-account-label Manager
                     else
                        span.nav-account-icon(aria-hidden="true") ♙
                        span.nav-account-label Account


            else
               a.nav-login(href="/login") Log in
            include partials/theme-toggle
            a.button.button-small(href="#salon-search-form") Find a barber

         main
