            width: 72px; height: 58px; border-radius: 8px; object-fit: cover;
            display: block; background: #24241f; border: 1px solid #454438;
         }
         .top-salons-section .top-salon-image-fallback {
            display: grid; place-items: center; color: #c5a66b; font-weight: 800;
            font-size: 12px; text-align: center; overflow: hidden; padding: 4px;
         }
         .top-salons-section .top-salon-info h3 { margin: 0 0 5px; }
         .top-salons-section .top-salon-info p { margin: 0 0 4px; color: #a5a69e; font-size: 12px; }
