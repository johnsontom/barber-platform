- const enabledCategories = typeof categories === "undefined" ? [] : categories
- const currentCategory = typeof selectedCategory === "undefined" ? null : selectedCategory
- const barberOnly = currentCategory ? currentCategory.slug === "barbers" : enabledCategories.length === 1 && enabledCategories[0].slug === "barbers"
- const teamTitle = currentCategory ? currentCategory.staff_plural : barberOnly ? "Barbers" : "Professionals"
doctype html
html(lang="en")
   head
      meta(charset="UTF-8")
