         .top-salons-section { padding: 70px 7.2%; border-top: 1px solid #303229; }
         .top-salons-section .top-salons-list { border-top: 1px solid #303229; }
         .top-salons-section .top-salon-row {
            display: grid;
            grid-template-columns: 36px 72px minmax(0, 1fr) minmax(150px, 230px) auto;
            align-items: center;
