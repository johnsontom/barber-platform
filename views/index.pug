      script(type="module" src="/js/scene.js")
      script(src="/js/main.js" defer)
      script(src="/js/salon-modal.js" defer)
      script.
         (() => {
            document.addEventListener("DOMContentLoaded", () => {
               // HERO SEARCH: update salon results without reloading the page.
               const heroForm = document.getElementById("salon-search-form");

               if (heroForm) {
                  heroForm.addEventListener("submit", async (event) => {
                     event.preventDefault();

                     const input = heroForm.querySelector('input[name="q"]');
                     const button = heroForm.querySelector('button[type="submit"]');
                     const query = input ? input.value.trim() : "";

                     if (!query) {
                        input?.focus();
                        return;
                     }

                     if (button) {
                        button.disabled = true;
                        button.textContent = "Searching...";
                     }

                     try {
                        const url = new URL(window.location.href);
                        url.hash = "";
                        url.searchParams.set("q", query);

                        const response = await fetch(url.toString(), {
                           method: "GET",
                           headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        if (!response.ok) {
                           throw new Error("The search request failed.");
                        }

                        const html = await response.text();
                        const parsedDocument = new DOMParser().parseFromString(html, "text/html");
                        const currentResults = document.querySelector("#salon-results");
                        const newResults = parsedDocument.querySelector("#salon-results");

                        if (!currentResults || !newResults) {
                           throw new Error("Salon results grid not found. Add the salon-results ID to the salon grid in index.pug.");
                        }

                        currentResults.replaceWith(newResults);
                        window.initialiseSalonDescriptions?.();
                        window.history.pushState({ heroSearch: true, query }, "", url.pathname + url.search);

                        document.querySelector("#discover")?.scrollIntoView({
                           behavior: "smooth",
                           block: "start"
                        });
                     } catch (error) {
                        console.error("Hero search error:", error);
                        alert("We couldn't complete your search. Please try again.");
                     } finally {
                        if (button) {
                           button.disabled = false;
                           button.textContent = "Search";
                        }
                     }
                  });
               }

               // LOCATION BAR: keep its existing geolocation and manual-area behaviour.
               const locationForm = document.getElementById("location-bar-form");
               const area = document.getElementById("location-area");
               const latInput = document.getElementById("location-lat");
               const lngInput = document.getElementById("location-lng");
               const serviceInput = document.getElementById("location-service");
               const currentButton = document.getElementById("location-current-button");
               const status = document.getElementById("location-status");

               if (!locationForm || !area || !latInput || !lngInput || !status) return;

               let requestInProgress = false;

               function requestLocation() {
                  if (requestInProgress) return;

                  if (!navigator.geolocation) {
                     status.textContent = "Location isn't supported here. Enter your postcode or area.";
                     return;
                  }

                  requestInProgress = true;
                  if (currentButton) currentButton.disabled = true;
                  status.textContent = "Finding your location…";

                  navigator.geolocation.getCurrentPosition(
                     (position) => {
                        latInput.value = position.coords.latitude;
                        lngInput.value = position.coords.longitude;
                        area.value = "";

                        if (serviceInput) {
                           serviceInput.value = document.querySelector("#salon-search-form select[name='service']")?.value || "";
                        }

                        status.textContent = "Location found. Finding nearby salons…";
                        locationForm.requestSubmit();
                     },
                     (error) => {
                        const messages = {
                           1: "Location permission denied. Enter an area or allow location access.",
                           2: "Couldn't determine your location. Try entering your area.",
                           3: "Location request timed out. Please try again."
                        };

                        status.textContent = messages[error.code] || "Couldn't get your location. Enter an area manually.";
                        if (currentButton) currentButton.disabled = false;
                        requestInProgress = false;
                     },
                     {
                        enableHighAccuracy: false,
                        timeout: 10000,
                        maximumAge: 60000
                     }
                  );
               }

               area.addEventListener("input", () => {
                  // A manually entered area must not accidentally use old GPS coordinates.
                  latInput.value = "";
                  lngInput.value = "";
                  status.textContent = area.value.trim()
                     ? "Search salons around the area you entered."
                     : "Use your current location or enter an area.";
               });

               locationForm.addEventListener("submit", (event) => {
                  const manualLocation = area.value.trim();

                  if (manualLocation) {
                     latInput.value = "";
                     lngInput.value = "";
                     return;
                  }

                  if (!latInput.value || !lngInput.value) {
                     event.preventDefault();
                     requestLocation();
                  }
               });

               currentButton?.addEventListener("click", requestLocation);

              // Scroll to the salon results after a location search completes.
              const searchParams = new URLSearchParams(window.location.search);

              const hasLocationSearch =
                searchParams.has("location") ||
                (searchParams.has("lat") && searchParams.has("lng"));

              if (hasLocationSearch) {
                window.addEventListener("load", () => {
                  const results = document.querySelector("#discover");

                  if (results) {
                    setTimeout(() => {
                      results.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                      });
                    }, 300);
                  }
                });
              }


               // Auto-request only when the page has no location choice yet.
               const hasCoordinates = latInput.value !== "" && lngInput.value !== "";
               const hasManualLocation = area.value.trim() !== "";

               if (!hasCoordinates && !hasManualLocation) {
                  requestLocation();
               }
            });
         })();
