         }
         .top-barbers-section .top-barber-rating {
            display: flex;
            align-items: center;
            gap: 5px;
            color: #f5f3ed;
         }
         .top-barbers-section .top-barber-rating small {
            color: #a5a69e;
            font-size: 11px;
         }
         .top-barbers-section .top-barber-link {
