

doctype html

html(lang="en")

  head

    meta(charset="UTF-8")

    meta(name="viewport" content="width=device-width, initial-scale=1")

    meta(name="theme-color" content="#10120D")

    title= title

    link(rel="stylesheet" href="/css/styles.css")

    style.

      .booking-management {

        --bm-bg: #10120d;

        --bm-panel: #191c15;

        --bm-panel-light: #20241a;

        --bm-border: #343a2a;

        --bm-text: #f4f5ed;

        --bm-muted: #b6bcaa;

        --bm-accent: #c7ff55;

        color: var(--bm-text);

      }



      .booking-management .admin-muted {

        color: var(--bm-muted) !important;

      }



      .booking-management .owner-hero {

        background: linear-gradient(125deg, #22291a, #151810);

        border: 1px solid var(--bm-border);

        border-radius: 18px;

      }



      .booking-management .owner-section {

        margin-top: 34px;

      }



      .booking-management .booking-section {

        margin: 26px 0 38px;

        scroll-margin-top: 20px;

      }



      .booking-management .booking-section-heading {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 16px;

        flex-wrap: wrap;

        margin-bottom: 17px;

      }



      .booking-management .booking-section-heading h2 {

        color: var(--bm-text);

        margin: 0 0 5px;

        font-size: 23px;

      }



      .booking-management .booking-section-heading p {

        margin: 0;

        color: var(--bm-muted);

      }



      .booking-management .booking-count {

        display: inline-flex;

        align-items: center;

        justify-content: center;

        min-width: 38px;

        min-height: 32px;

        padding: 5px 11px;

        border-radius: 9px;

        border: 1px solid var(--bm-border);

        background: var(--bm-panel-light);

        color: var(--bm-accent);

        font-size: 13px;

        font-weight: 800;

      }



      .booking-management .booking-cards {

        display: grid;

        grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));

        gap: 16px;

      }



      .booking-management .appointment-card {

        min-width: 0;

        box-sizing: border-box;

        padding: 22px;

        background: var(--bm-panel);

        color: var(--bm-text);

        border: 1px solid var(--bm-border);

        border-radius: 16px;

        box-shadow: 0 8px 25px rgba(0,0,0,.12);

        transition: border-color .2s, transform .2s;

      }



      .booking-management .appointment-card:hover {

        border-color: #667348;

        transform: translateY(-2px);

      }



      .booking-management .appointment-card[hidden] {

        display: none !important;

      }



      .booking-management .appointment-card-top {

        display: flex;

        justify-content: space-between;

        align-items: flex-start;

        gap: 12px;

      }



      .booking-management .appointment-card h3 {

        color: var(--bm-text) !important;

        font-size: 20px;

        line-height: 1.3;

        margin: 12px 0 5px;

        overflow-wrap: anywhere;

      }



      .booking-management .owner-location {

        color: var(--bm-muted) !important;

        margin: 0;

      }



      .booking-management .owner-status {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        font-size: 11px;

        font-weight: 800;

        letter-spacing: .08em;

        text-transform: uppercase;

        color: var(--bm-accent);

      }



      .booking-management .owner-status-dot {

        color: var(--bm-accent);

      }



      .booking-management .booking-status-badge {

        flex-shrink: 0;

        padding: 6px 9px;

        border: 1px solid var(--bm-border);

        border-radius: 8px;

        background: #25291f;

        color: var(--bm-text);

        font-size: 10px;

        font-weight: 800;

        letter-spacing: .04em;

        text-transform: uppercase;

      }



      .booking-management .status-pending {

        color: #ffe09a;

        border-color: #65522b;

        background: #302819;

      }



      .booking-management .status-upcoming {

        color: #b9d7ff;

        border-color: #344b66;

        background: #1d2a39;

      }



      .booking-management .status-ongoing {

        color: #c7ff55;

        border-color: #4b6029;

        background: #26331a;

      }



      .booking-management .status-completed {

        color: #9ee8bd;

        border-color: #315744;

        background: #1b3025;

      }



      .booking-management .status-cancelled {

        color: #ffb4ae;

        border-color: #69403c;

        background: #352321;

      }



      .booking-management .booking-detail-grid {

        display: grid;

        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 18px 14px;

        padding: 19px 0;

        margin-top: 19px;

        border-top: 1px solid var(--bm-border);

        border-bottom: 1px solid var(--bm-border);

      }



      .booking-management .owner-detail {

        min-width: 0;

        display: flex;

        flex-direction: column;

        gap: 7px;

      }



      .booking-management .owner-detail-label {

        color: #c5cbb9 !important;

        font-size: 10px;

        font-weight: 800;

        letter-spacing: .11em;

      }



      .booking-management .owner-detail strong {

        color: var(--bm-text) !important;

        font-size: 13px;

        font-weight: 600;

        line-height: 1.5;

        overflow-wrap: anywhere;

      }



      .booking-management .booking-price {

        color: var(--bm-accent) !important;

      }



      .booking-management .booking-notes {

        margin: 17px 0 0;

        padding: 13px;

        border: 1px solid var(--bm-border);

        border-radius: 10px;

        background: #141710;

        color: var(--bm-muted);

        font-size: 13px;

        line-height: 1.65;

        overflow-wrap: anywhere;

      }



      .booking-management .booking-notes strong {

        color: var(--bm-text);

      }



      .booking-management .booking-actions {

        display: flex;

        flex-wrap: wrap;

        gap: 9px;

        margin-top: 18px;

      }



      .booking-management .booking-actions form {

        margin: 0;

      }



      .booking-management .booking-action {

        min-height: 40px;

        padding: 10px 13px;

        border: 1px solid #4a533b;

        border-radius: 9px;

        background: #252c1d;

        color: var(--bm-text);

        font: inherit;

        font-size: 12px;

        font-weight: 700;

        cursor: pointer;

        transition: background .2s, border-color .2s;

      }



      .booking-management .booking-action:hover {

        background: #343e27;

        border-color: var(--bm-accent);

      }



      .booking-management .booking-action-primary {

        background: var(--bm-accent);

        color: #171b10;

        border-color: var(--bm-accent);

      }



      .booking-management .booking-action-primary:hover {

        background: #d8ff89;

        color: #171b10;

      }



      .booking-management .booking-action-danger {

        color: #ffb4ae;

        border-color: #69403c;

        background: #30211f;

      }



      .booking-management .booking-action-danger:hover {

        background: #442724;

      }



      .booking-management .booking-empty {

        padding: 24px;

        background: var(--bm-panel);

        border: 1px dashed #424936;

        border-radius: 14px;

        color: var(--bm-muted);

        line-height: 1.6;

      }



      .booking-management .booking-empty strong {

        display: block;

        margin-bottom: 5px;

        color: var(--bm-text);

      }



      .booking-management .booking-pagination {

        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 12px;

        flex-wrap: wrap;

        padding: 16px 2px 0;

      }



      .booking-management .pagination-info {

        color: var(--bm-muted);

        font-size: 12px;

      }



      .booking-management .pagination-controls {

        display: flex;

        align-items: center;

        gap: 7px;

      }



      .booking-management .pagination-button {

        min-width: 38px;

        min-height: 36px;

        padding: 7px 11px;

        border: 1px solid var(--bm-border);

        border-radius: 8px;

        background: var(--bm-panel);

        color: var(--bm-text);

        font: inherit;

        font-size: 12px;

        cursor: pointer;

      }



      .booking-management .pagination-button:hover:not(:disabled) {

        border-color: var(--bm-accent);

        color: var(--bm-accent);

      }



      .booking-management .pagination-button:disabled {

        opacity: .35;

        cursor: not-allowed;

      }



      .booking-management .pagination-page {

        min-width: 65px;

        text-align: center;

        color: var(--bm-text);

        font-size: 12px;

        font-weight: 700;

      }



      .booking-management .booking-overview {

        display: grid;

        grid-template-columns: repeat(5, minmax(0, 1fr));

        gap: 12px;

        margin: 26px 0;

      }



      .booking-management .booking-overview a {

        display: flex;

        flex-direction: column;

        gap: 9px;

        padding: 16px;

        text-decoration: none;

        background: var(--bm-panel);

        border: 1px solid var(--bm-border);

        border-radius: 12px;

        transition: border-color .2s;

      }



      .booking-management .booking-overview a:hover {

        border-color: var(--bm-accent);

      }



      .booking-management .overview-label {

        color: var(--bm-muted);

        font-size: 10px;

        font-weight: 800;

        letter-spacing: .08em;

        text-transform: uppercase;

      }



      .booking-management .overview-number {

        color: var(--bm-text);

        font-size: 25px;

        font-weight: 800;

      }



      .booking-management .owner-help-panel {

        margin-top: 35px;

        background: var(--bm-panel);

        border: 1px solid var(--bm-border);

        border-radius: 14px;

        color: var(--bm-muted);

      }



      .booking-management .owner-help-panel h3 {

        color: var(--bm-text);

      }



      .booking-management .owner-help-panel p {

        color: var(--bm-muted);

      }



      @media (max-width: 900px) {

        .booking-management .booking-overview {

          grid-template-columns: repeat(3, minmax(0, 1fr));

        }

      }



      @media (max-width: 560px) {

        .booking-management .booking-overview {

          grid-template-columns: repeat(2, minmax(0, 1fr));

        }



        .booking-management .booking-cards {

          grid-template-columns: minmax(0, 1fr);

        }



        .booking-management .appointment-card {

          padding: 17px;

        }



        .booking-management .booking-detail-grid {

          gap: 16px 10px;

        }



        .booking-management .booking-pagination {

          align-items: flex-start;

        }

      }

      .booking-management .booking-search {

        margin: 0 0 16px;

      }



      .booking-management .booking-search label {

        display: block;

        margin-bottom: 8px;

        color: #c5cbb9;

        font-size: 11px;

        font-weight: 800;

        letter-spacing: .08em;

        text-transform: uppercase;

      }



      .booking-management .booking-search-input {

        display: block;

        width: 100%;

        max-width: 480px;

        box-sizing: border-box;

        padding: 13px 15px;

        border: 1px solid #343a2a;

        border-radius: 10px;

        background: #191c15;

        color: #f4f5ed;

        font: inherit;

        font-size: 13px;

        outline: none;

      }



      .booking-management .booking-search-input::placeholder {

        color: #929987;

      }



      .booking-management .booking-search-input:focus {

        border-color: #c7ff55;

        box-shadow: 0 0 0 3px rgba(199, 255, 85, .1);

      }



      .booking-management .booking-search-input:focus-visible {

        outline: 2px solid #c7ff55;

        outline-offset: 2px;

      }



  body.admin-body.booking-management

    aside.admin-sidebar

      a.admin-brand(href="/dashboard")

        span.brand-mark B.

        span BARBER PLATFORM



      p.admin-nav-label WORKSPACE

      a.admin-nav-link(href="/dashboard") Overview

      a.admin-nav-link(href="/salons/manage") My Salon

      a.admin-nav-link.active(href="/appointments/manage") Appointments

      a.admin-nav-link(href="/") View Public Website



      div.admin-sidebar-bottom

        span.admin-status-dot ●

        span Approved salon owner

        form(action="/logout" method="POST")

          button.admin-logout(type="submit") Log out



    main.admin-main

      header.admin-topbar

        div

          p.eyebrow OWNER WORKSPACE

          h1 Manage Appointments

          p.admin-muted View bookings for your assigned salons.

        a.admin-back-link(href="/dashboard") ← Dashboard



      section.admin-welcome.owner-hero

        div

          span.admin-welcome-tag BOOKING MANAGEMENT

          h2 Your bookings. All in one place.

          p Review customer bookings and keep appointments up to date.

        div.admin-welcome-symbol B.



      section.owner-section

        div.dashboard-section-heading

          div

            p.eyebrow APPOINTMENTS

            h2 Your bookings

            p.admin-muted Manage each appointment by its current status.



        nav.booking-overview(aria-label="Jump to appointment sections")

          a(href="#pending-section")

            span.overview-label Pending

            span.overview-number= sections.pending.length

          a(href="#upcoming-section")

            span.overview-label Upcoming

            span.overview-number= sections.upcoming.length

          a(href="#ongoing-section")

            span.overview-label Ongoing

            span.overview-number= sections.ongoing.length

          a(href="#completed-section")

            span.overview-label Completed

            span.overview-number= sections.completed.length

          a(href="#cancelled-section")

            span.overview-label Cancelled

            span.overview-number= sections.cancelled.length



        //- Each section has its own pagination state.

        each group in [{key: 'pending', title: 'Pending appointments', description: 'Requests waiting for your decision.', items: sections.pending}, {key: 'upcoming', title: 'Upcoming appointments', description: 'Confirmed appointments scheduled for later.', items: sections.upcoming}, {key: 'ongoing', title: 'Ongoing appointments', description: 'Confirmed appointments currently within their scheduled duration.', items: sections.ongoing}, {key: 'completed', title: 'Completed appointments', description: 'Appointments that have been marked as completed.', items: sections.completed}, {key: 'cancelled', title: 'Cancelled appointments', description: 'Cancelled bookings kept for reference.', items: sections.cancelled}]

          section.booking-section(id=group.key + '-section' data-booking-section=group.key)

            div.booking-section-heading

              div

                h2= group.title

                p= group.description

              span.booking-count= group.items.length



            div.booking-search

              label(for=group.key + '-search') Search #{group.title.toLowerCase()}

              input.booking-search-input(

                id=group.key + '-search'

                type="search"

                placeholder="Search customer, email, service, salon or booking ID..."

                autocomplete="off"

                data-section-search

              )



            if group.items.length

              div.booking-cards

                each appointment in group.items

                  article.appointment-card(data-page-card)

                    div.appointment-card-top

                      div

                        span.owner-status

                          span.owner-status-dot ●

                          |  #{group.key === 'upcoming' || group.key === 'ongoing' ? 'CONFIRMED' : group.key.toUpperCase()}

                        h3= appointment.service_name

                        p.owner-location= appointment.salon_name

                      span.booking-status-badge(class='status-' + group.key)= group.key



                    div.booking-detail-grid

                      div.owner-detail

                        span.owner-detail-label CUSTOMER

                        strong= appointment.customer_name

                      div.owner-detail

                        span.owner-detail-label EMAIL

                        strong= appointment.customer_email

                      div.owner-detail

                        span.owner-detail-label DATE *&* TIME

                        strong= new Date(appointment.appointment_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })

                      div.owner-detail

                        span.owner-detail-label PRICE

                        strong.booking-price= '£' + Number(appointment.service_price).toFixed(2)

                      div.owner-detail

                        span.owner-detail-label DURATION

                        strong= appointment.duration_minutes + ' minutes'

                      div.owner-detail

                        span.owner-detail-label BOOKING REFERENCE

                        strong= '#' + appointment.id



                    if appointment.notes

                      p.booking-notes

                        strong Customer notes:&#x20;

                        | #{appointment.notes}



                    div.booking-actions

                      if appointment.status === 'pending'

                        form(action="/appointments/" + appointment.id + "/status" method="POST")

                          button.booking-action.booking-action-primary(type="submit" name="status" value="confirmed") Confirm booking

                        form(action="/appointments/" + appointment.id + "/status" method="POST")

                          button.booking-action.booking-action-danger(type="submit" name="status" value="cancelled") Cancel booking



                      else if appointment.status === 'confirmed'

                        form(action="/appointments/" + appointment.id + "/status" method="POST")

                          button.booking-action.booking-action-primary(type="submit" name="status" value="completed") Mark completed

                        form(action="/appointments/" + appointment.id + "/status" method="POST")

                          button.booking-action.booking-action-danger(type="submit" name="status" value="cancelled") Cancel booking



                      else

                        p.admin-muted This appointment is #{appointment.status}.



              div.booking-pagination(data-pagination)

                span.pagination-info(data-pagination-info)

                div.pagination-controls

                  button.pagination-button(type="button" data-prev) Previous

                  span.pagination-page(data-page-label) Page 1

                  button.pagination-button(type="button" data-next) Next

            else

              div.booking-empty

                strong No #{group.key} appointments

                | Appointments in this section will appear here when available.



      section.owner-help-panel

        div.owner-help-icon i

        div

          h3 Keep your bookings up to date

          p Confirm requests promptly and mark appointments as completed after the service.



    script.

      (() => {

        const pageSize = 5;



        document.querySelectorAll('[data-booking-section]').forEach((section) => {

          const cards = Array.from(section.querySelectorAll('[data-page-card]'));

          const search = section.querySelector('[data-section-search]');

          const pagination = section.querySelector('[data-pagination]');



          let currentPage = 1;



          if (!pagination) return;



          const info = pagination.querySelector('[data-pagination-info]');

          const label = pagination.querySelector('[data-page-label]');

          const previous = pagination.querySelector('[data-prev]');

          const next = pagination.querySelector('[data-next]');



          function getMatches() {

            const query = (search?.value || '').trim().toLowerCase();



            if (!query) return cards;



            return cards.filter((card) =>

              card.textContent.toLowerCase().includes(query)

            );

          }



          function renderPage() {

            const matches = getMatches();

            const totalPages = Math.ceil(matches.length / pageSize);



            if (totalPages > 0 && currentPage > totalPages) {

              currentPage = totalPages;

            }



            if (totalPages === 0) {

              currentPage = 1;

            }



            const start = (currentPage - 1) * pageSize;

            const end = Math.min(start + pageSize, matches.length);

            const visibleCards = new Set(matches.slice(start, end));



            cards.forEach((card) => {

              card.hidden = !visibleCards.has(card);

            });



            if (matches.length === 0) {

              info.textContent = 'No matching appointments found.';

            } else {

              info.textContent =

                `Showing ${start + 1}–${end} of ${matches.length} appointments`;

            }



            label.textContent = `Page ${currentPage} of ${Math.max(totalPages, 1)}`;

            previous.disabled = currentPage <= 1;

            next.disabled = currentPage >= totalPages;

          }



          previous.addEventListener('click', () => {

            if (currentPage > 1) {

              currentPage--;

              renderPage();

            }

          });



          next.addEventListener('click', () => {

            currentPage++;

            renderPage();

          });



          if (search) {

            search.addEventListener('input', () => {

              currentPage = 1;

              renderPage();

            });

          }



          renderPage();

        });

      })();
