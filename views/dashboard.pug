
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Dashboard | Barber Platform
    link(rel="stylesheet" href="/css/styles.css")

  body.admin-body
    aside.admin-sidebar
      a.admin-brand(href="/dashboard")
        span.brand-mark B.
        span BARBER PLATFORM

      p.admin-nav-label WORKSPACE
      a.admin-nav-link.active(href="/dashboard") Overview

      if user.role === "admin"
        a.admin-nav-link(href="/admin/salons") Salon Management
        a.admin-nav-link(href="/admin/applications") Owner Applications

      if user.role === "barber" && user.approvalStatus === "approved"
        a.admin-nav-link(href="/salons/manage") Manage My Salon

      a.admin-nav-link(href="/") View Public Website

      div.admin-sidebar-bottom
        span.admin-status-dot ●
        span= user.role === "admin" ? "Administrator" : user.role === "barber" ? "Salon owner" : "Customer"
        form(action="/logout" method="POST")
          button.admin-logout(type="submit") Log out

    main.admin-main
      header.admin-topbar
        div
          p.eyebrow YOUR WORKSPACE
          h1 Dashboard
          p.admin-muted Your Barber Platform overview.
        span.dashboard-role-badge= user.role === "admin" ? "ADMIN" : user.role === "barber" ? "SALON OWNER" : "CUSTOMER"

      section.admin-welcome.dashboard-hero
        div
          span.admin-welcome-tag WELCOME BACK
          h2= user.fullName || user.full_name || "Welcome"
          p= user.role === "admin" ? "Your platform workspace is ready. Manage salons and review owner applications." : user.role === "barber" ? "Manage your owner application and salon access from one place." : "Find your next cut and discover salons in your area."
        div.admin-welcome-symbol B.

      if user.role === "admin"
        section.dashboard-section
          div.dashboard-section-heading
            div
              p.eyebrow PLATFORM CONTROL
              h2 Administration
              p.admin-muted Everything you need to manage the platform.

          div.dashboard-card-grid
            a.dashboard-feature-card(href="/admin/salons")
              span.dashboard-card-icon
                svg(viewBox="0 0 24 24" aria-hidden="true")
                  path(d="M3 10h18M5 10V21h14V10M3 10l2-7h14l2 7M9 21v-7h6v7")
              span.dashboard-card-label PLATFORM DIRECTORY
              strong Manage Salons
              p Create salon listings, edit details, and assign approved owners.
              span.dashboard-card-link Open salon management →
            a.dashboard-feature-card(href="/admin/applications")
              span.dashboard-card-icon
                svg(viewBox="0 0 24 24" aria-hidden="true")
                  circle(cx="9" cy="8" r="4")
                  path(d="M3 21v-2a6 6 0 0 1 12 0v2M16 3.5a4 4 0 0 1 0 7.5M18 15a5 5 0 0 1 3 4.6V21")
              span.dashboard-card-label ACCESS CONTROL
              strong Owner Applications
              p Review salon-owner registrations and manage access.
              span.dashboard-card-link Review applications →

      else if user.role === "customer"
        section.dashboard-section
          div.dashboard-section-heading
            div
              p.eyebrow DISCOVER
              h2 Find your next cut
              p.admin-muted Explore the salon directory and find a style that suits you.

          div.dashboard-card-grid
            a.dashboard-feature-card(href="/")
              span.dashboard-card-icon
                svg(viewBox="0 0 24 24" aria-hidden="true")
                  circle(cx="10.5" cy="10.5" r="6.5")
                  path(d="m16 16 5 5")
              span.dashboard-card-label SALON DIRECTORY
              strong Browse Salons
              p Discover available salons and explore their details.
              span.dashboard-card-link Explore salons →

      else if user.role === "barber" && user.approvalStatus === "pending"
        section.dashboard-section
          div.dashboard-section-heading
            div
              p.eyebrow ACCOUNT STATUS
              h2 Your application
              p.admin-muted Your owner account is waiting for an administrator's decision.

          article.dashboard-status-card
            span.dashboard-status-icon ...
            div
              span.dashboard-status-badge.pending PENDING REVIEW
              h3 You're in the queue
              p Your account has been created. Once approved, you can be assigned to a salon and access owner management features.

      else if user.role === "barber" && user.approvalStatus === "rejected"
        section.dashboard-section
          article.dashboard-status-card
            span.dashboard-status-icon !
            div
              span.dashboard-status-badge.rejected NOT APPROVED
              h3 Your application was not approved
              p Please contact the platform administrator for further information.

      else if user.role === "barber" && user.approvalStatus === "approved"
        section.dashboard-section
          div.dashboard-section-heading
            div
              p.eyebrow OWNER WORKSPACE
              h2 Your business
              p.admin-muted Your account is approved for salon management.

          div.dashboard-card-grid
            a.dashboard-feature-card(href="/salons/manage")
              span.dashboard-card-icon
                svg(viewBox="0 0 24 24" aria-hidden="true")
                  path(d="M3 10h18M5 10V21h14V10M3 10l2-7h14l2 7M9 21v-7h6v7")
              span.dashboard-card-label SALON WORKSPACE
              strong Manage My Salon
              p Access your salon management page and maintain your business details.
              span.dashboard-card-link Open my salon →

      footer.dashboard-footer
        span BARBER PLATFORM
        a(href="/") Return to homepage
