
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Create Account | Barber Platform
    link(rel="stylesheet" href="/css/styles.css")

  body.auth-body
    main.auth-layout
      section.auth-visual
        a.auth-brand(href="/")
          span.brand-mark B.
          span BARBER PLATFORM

        .auth-visual-content
          p.eyebrow YOUR NEXT CHAPTER STARTS HERE
          h1 Great style.
            br
            span Great connections.
          p Discover trusted barbers, find your next cut, or bring your salon to the platform.

        .auth-visual-footer
          span BUILT FOR THE COMMUNITY
          span EST. 2026

      section.auth-form-side
        div.auth-form-wrap
          a.auth-mobile-brand(href="/") BARBER PLATFORM

          p.eyebrow GET STARTED
          h2 Create your account
          p.auth-subtitle Join Barber Platform in just a few steps.

          if error
            .auth-error(role="alert")= error

          form.auth-form(action="/register" method="POST")
            div.form-field
              label(for="full_name") Full name
              input#full_name(type="text" name="full_name" maxlength="120" placeholder="Enter your full name" required autocomplete="name")

            div.form-field
              label(for="email") Email address
              input#email(type="email" name="email" maxlength="190" placeholder="you@example.com" required autocomplete="email")

            div.form-field
              label(for="password") Password
              input#password(type="password" name="password" minlength="8" placeholder="At least 8 characters" required autocomplete="new-password")
              p.field-hint Use at least 8 characters.

            div.form-field
              label Account type

              div.account-options
                label.account-option
                  input(type="radio" name="role" value="customer" checked required)
                  span.account-option-card
                    span.account-icon
                      svg(viewBox="0 0 24 24" aria-hidden="true")
                        path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                        circle(cx="12" cy="7" r="4")
                    span.account-option-text
                      strong Customer
                      small Discover salons and book appointments
                    span.account-check ✓

                label.account-option
                  input(type="radio" name="role" value="barber" required)
                  span.account-option-card
                    span.account-icon
                      svg(viewBox="0 0 24 24" aria-hidden="true")
                        circle(cx="6" cy="6" r="3")
                        circle(cx="6" cy="18" r="3")
                        path(d="m8.1 8.1 12.8 12.8M8.1 15.9 20.9 3.1")
                    span.account-option-text
                      strong Salon owner
                      small Apply to manage your salon
                    span.account-check ✓

              p.field-hint Salon owner accounts require administrator approval before salon management access.

            button.auth-submit(type="submit")
              span Create account
              span(aria-hidden="true") →

          p.auth-switch Already have an account? 
            a(href="/login") Log in

          a.auth-back(href="/") ← Back to homepage
